<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LiveCoach</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <!-- Optional and git-ignored: sets LiveCoachDefaultUrl for your own deployment. See LiveCoach.local.props.example. -->
  <Import Project="$(MSBuildThisFileDirectory)LiveCoach.local.props" Condition="Exists('$(MSBuildThisFileDirectory)LiveCoach.local.props')" />
  <ItemGroup Condition="'$(LiveCoachDefaultUrl)' != ''">
    <AssemblyMetadata Include="LiveCoachDefaultUrl" Value="$(LiveCoachDefaultUrl)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <ProjectReference Include="..\VoiceAssistant.Audio\VoiceAssistant.Audio.csproj" />
    <InternalsVisibleTo Include="VoiceAssistant.WebOverlay.Tests" />
  </ItemGroup>
</Project>
